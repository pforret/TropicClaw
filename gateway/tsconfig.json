{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "paths": {
      "grammy": ["./node_modules/grammy"],
      "twitter-api-v2": ["./node_modules/twitter-api-v2"]
    }
  },
  "include": ["src/**/*.ts", "../apps/**/*.ts"],
  "exclude": ["node_modules", "dist", "../apps/bookmarks/publish"]
}
